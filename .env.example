# Copia este archivo a .env (o .env.local para overrides que no se versionan)
# y ajusta los valores.
#
# Reglas:
#   - Solo las variables con prefijo VITE_ llegan al navegador.
#   - Se leen con import.meta.env.VITE_LO_QUE_SEA
#   - NUNCA pongas secretos (tokens, contraseñas, API keys privadas):
#     todo lo que lleve el prefijo VITE_ termina en texto plano en dist/.

VITE_SITE_NAME="JVCloud Consultores"
# El destino del formulario de contacto NO va acá: vive en
# public/config.json (bloque `formulario`), para poder cambiarlo sin
# recompilar el sitio.

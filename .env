# Variables públicas del sitio.
# Solo se exponen al bundle las que empiezan con VITE_.
# NUNCA pongas secretos aquí: todo queda en texto plano dentro de dist/.

VITE_SITE_NAME="JVCloud Consultores"
# El destino del formulario de contacto NO va acá: vive en
# public/config.json (bloque `formulario`), para poder cambiarlo sin
# recompilar el sitio.

# OPCIONAL. Contacto extra del pie de página. Una sola línea,
# "Nombre,Teléfono": primero el nombre, una coma, y después el número.
# Se muestra SOLO en el footer, debajo del último contacto, y no toca
# el bloque `contact` de config.json, el widget de WhatsApp ni el formulario.
# Sin definir, vacía o sin coma, el footer se pinta igual y no aparece
# esa línea. Descoméntala solo si quieres el contacto extra.
VITE_FOOTER_CONTACTO="Victor,+56 9 0000 0000"
